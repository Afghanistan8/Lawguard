# ---------------------------------------------------------------------------
# Lawguard frontend environment configuration.
# Copy this file to `.env` (in the frontend/ folder) and adjust as needed.
# All variables are build-time (Vite `import.meta.env`), so re-build/re-deploy
# after changing them.
#
# Lawguard targets GenLayer StudioNet ONLY (chain 61999) — there is no network
# selector in the app, so there is no network variable here to set.
# ---------------------------------------------------------------------------

# Address of the deployed Lawguard Intelligent Contract on StudioNet
# (0x… 40 hex chars). Live deployment:
VITE_LAWGUARD_CONTRACT_ADDRESS=0xA7D9B1B288E4D1da9C94aC9b06452c7bdbCfd298

# Optional: override the RPC endpoint (otherwise StudioNet's default RPC is
# used: https://studio.genlayer.com/api). Useful for a local GenLayer Studio,
# a proxy, or a private RPC — but it must still serve a StudioNet-compatible
# (chain 61999) node.
# VITE_GENLAYER_RPC_URL=http://127.0.0.1:4000/api
