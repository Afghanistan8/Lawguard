# ---------------------------------------------------------------------------
# Lawguard frontend environment configuration.
# Copy this file to `.env` (in the frontend/ folder) and adjust as needed.
# All variables are build-time (Vite `import.meta.env`), so re-build/re-deploy
# after changing them.
# ---------------------------------------------------------------------------

# Target GenLayer network. One of:
#   studionet         — GenLayer StudioNet     (chain 61999)  [default]
#   testnet_bradbury  — GenLayer Bradbury      (chain 4221)
#   testnet_asimov    — GenLayer Asimov        (chain 4221, legacy pointer)
#   localnet          — local GenLayer Studio  (chain 61999)
VITE_GENLAYER_NETWORK=studionet

# Address of the deployed Lawguard Intelligent Contract (0x… 40 hex chars).
# Live StudioNet deployment (chain 61999):
VITE_LAWGUARD_CONTRACT_ADDRESS=0xA7D9B1B288E4D1da9C94aC9b06452c7bdbCfd298
# A mirror is also deployed on Bradbury testnet (chain 4221):
#   0x7d96FBdb186A2D7233803b795F8b4efdf360Ff47
# (If you target Bradbury, set VITE_GENLAYER_NETWORK=testnet_bradbury AND
#  point VITE_LAWGUARD_CONTRACT_ADDRESS at the Bradbury address above.)

# Optional: override the RPC endpoint (otherwise inferred from the network).
# Useful for a local GenLayer Studio, a proxy, or a private RPC.
# VITE_GENLAYER_RPC_URL=http://127.0.0.1:4000/api
